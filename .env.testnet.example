# Copy this file to .env.testnet and fill in your Hyperliquid testnet credentials.
# Get a testnet account at: https://app.hyperliquid-testnet.xyz
#
# This file is loaded on top of .env by the testnet Docker services,
# so it only needs the testnet-specific overrides.

TRADING_ENV=testnet
HYPERLIQUID_TESTNET_WALLET_ADDRESS=your_testnet_wallet_address_here
HYPERLIQUID_TESTNET_API_WALLET_ADDRESS=your_testnet_api_wallet_address_here
HYPERLIQUID_TESTNET_PRIVATE_KEY=your_testnet_private_key_here
